# ============================================================
# .env para PRODUÇÃO (servidor Fiocruz)
# Copie este arquivo como .env na raiz do projeto:
#   cp env.prod.example .env
# Depois preencha os campos marcados com TROCAR_*
# ============================================================

# Ambiente da aplicação — NUNCA use "development" em produção (apaga o banco!)
ENV=production

# Dados do ADMIN inicial (criado apenas na primeira execução)
ADMIN_NOME_COMPLETO=Administrador Sistema
ADMIN_EMAIL=TROCAR_EMAIL_ADMIN
ADMIN_SENHA=TROCAR_SENHA_ADMIN
ADMIN_CPF=TROCAR_CPF_ADMIN

# Configurações do JWT
JWT_SECRET_KEY=TROCAR_CHAVE_SECRETA_FORTE
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Configurações de Cookies
COOKIE_NAME=access_token
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Banco de Dados — MariaDB nativo do servidor
DATABASE_URL=mysql+pymysql://imgclass_user:TROCAR_SENHA_DB@localhost:3306/image_classification?charset=utf8mb4

# Configurações da API
API_HOST=0.0.0.0
API_PORT=8001

# CORS — URL(s) do frontend em produção (separadas por vírgula)
CORS_ORIGINS=TROCAR_URL_FRONTEND

# Configurações do NextCloud (WebDAV) — deixe vazios se não usar NextCloud
NEXTCLOUD_BASE_URL=
NEXTCLOUD_USERNAME=
NEXTCLOUD_PASSWORD=
NEXTCLOUD_WEBDAV_PATH=/remote.php/dav
NEXTCLOUD_USER_PATH=
NEXTCLOUD_MAX_PAGE_SIZE=100
NEXTCLOUD_VERIFY_SSL=true

# Configurações de Sincronização NextCloud
NEXTCLOUD_SYNC_ACTIVITY_API_INTERVAL=5
NEXTCLOUD_SYNC_WEBDAV_INTERVAL=300
NEXTCLOUD_SYNC_INITIAL_ON_STARTUP=true
NEXTCLOUD_SYNC_MAX_RETRIES=3
NEXTCLOUD_SYNC_RETRY_DELAY=30
NEXTCLOUD_SYNC_BATCH_SIZE=50

# Timezone
TIMEZONE=America/Sao_Paulo
