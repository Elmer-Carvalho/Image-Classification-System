# ============================================================
# .env preenchido para DESENVOLVIMENTO LOCAL (docker-compose)
# Copie este arquivo como .env na raiz do projeto:
#   cp env.example.filled .env
# ============================================================

# Ambiente da aplicação
ENV=development

# Dados do ADMIN inicial
ADMIN_NOME_COMPLETO=Administrador Sistema
ADMIN_EMAIL=admin@classificacao.local
ADMIN_SENHA=Admin@2026
ADMIN_CPF=52998224725

# Configurações do JWT
JWT_SECRET_KEY=dev-secret-key-troque-em-producao-abc123
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Configurações de Cookies
COOKIE_NAME=access_token
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Configurações do Banco de Dados
POSTGRES_USER=imgclass_user
POSTGRES_PASSWORD=imgclass_pass_2026
POSTGRES_DB=image_classification
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://imgclass_user:imgclass_pass_2026@postgres:5432/image_classification

# Configurações da API
API_HOST=0.0.0.0
API_PORT=8000

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Configurações do NextCloud (WebDAV) — deixe vazios se não usar NextCloud
NEXTCLOUD_BASE_URL=
NEXTCLOUD_USERNAME=
NEXTCLOUD_PASSWORD=
NEXTCLOUD_WEBDAV_PATH=/remote.php/dav
NEXTCLOUD_USER_PATH=
NEXTCLOUD_MAX_PAGE_SIZE=100
NEXTCLOUD_VERIFY_SSL=false

# Configurações de Sincronização NextCloud
NEXTCLOUD_SYNC_ACTIVITY_API_INTERVAL=5
NEXTCLOUD_SYNC_WEBDAV_INTERVAL=300
NEXTCLOUD_SYNC_INITIAL_ON_STARTUP=true
NEXTCLOUD_SYNC_MAX_RETRIES=3
NEXTCLOUD_SYNC_RETRY_DELAY=30
NEXTCLOUD_SYNC_BATCH_SIZE=50

# Timezone
TIMEZONE=America/Sao_Paulo
